@@ -0,0 +1,29 @@
+{
+  "_comment": "Bu dosyayı 'appsettings.json' olarak kopyalayıp kendi değerlerinle doldur. appsettings.json .gitignore'da olduğu için commit edilmez.",
+
+  "ConnectionStrings": {
+    "DefaultConnection": "Host=localhost;Port=5432;Database=ufmdb;Username=postgres;Password=CHANGE_ME"
+  },
+
+  "JwtSettings": {
+    "_comment": "Secret en az 32 karakter olmalı; production'da mutlaka rastgele/güçlü bir değerle değiştirin (örn. user-secrets veya ortam değişkeni ile).",
+    "Secret": "CHANGE_ME_REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS",
+    "Issuer": "UFMDb.API",
+    "Audience": "UFMDb.Client",
+    "AccessTokenExpirationMinutes": 60
+  },
+
+  "Cors": {
+    "_comment": "React frontend'in çalıştığı origin(ler). Vite dev server varsayılanı 5173'tür.",
+    "AllowedOrigins": [ "http://localhost:5173" ]
+  },
+
+  "Logging": {
+    "LogLevel": {
+      "Default": "Information",
+      "Microsoft.AspNetCore": "Warning"
+    }
+  },
+
+  "AllowedHosts": "*"
+}
