<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Class library projelerinde ASP.NET Core tiplerine (IHttpContextAccessor, ClaimsPrincipal
         extension'ları vb.) erişmek için eski NuGet paketleri yerine FrameworkReference kullanılır.
         Eski "Microsoft.AspNetCore.Http.Abstractions" NuGet paketi net8.0 ile uyumsuzdur ve
         FindFirstValue gibi extension metodların bulunamamasına sebep olur. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.6.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UFMDb.Application\UFMDb.Application.csproj" />
  </ItemGroup>
</Project>

